# Direct browser inference uses the account user key connected in Account settings.
# OPENROUTER_API_KEY below is for operator tooling; no key is embedded by Vite.
# Public voice defaults, embedded at build time: edit .env then rebuild/redeploy.
# Speaker: F1-F5, M1, M2. Pitch/rate: 0.8-1.4. Pitch also speeds up playback.
# A changed preset migrates saved audio settings while retaining mute/avatar/sprite.
VITE_NATALLY_VOICE="F4"
VITE_NATALLY_VOICE_PITCH="1.15"
VITE_NATALLY_VOICE_RATE="0.90"
# Maximum chunk characters, 100-800; adaptive policy caps at 240 (180 on gentle/slow devices).
VITE_NATALLY_SPEECH_CHUNK_CHARS="240"
# Direct browser inference uses openrouter/free; no Netlify LLM function.
# There is no GLM or paid fallback in the browser client.
# OPENROUTER_ADMIN_KEY is for billing provisioning, never inference.
FIREBASE_API_KEY=""
# Netlify Functions secrets only; never prefix these with VITE_.
# Temporary personal-key grant for the verified development account; paid access
# continues to follow DOCS/BILLING-SPEC.md. Remove this grant when billing is live.
NATALLY_DEV_ACCESS_EMAIL=""
NATALLY_DEV_ACCESS_EXPIRES_AT=""
NATALLY_DEV_OPENROUTER_KEY=""
FRONTEND_ORIGIN="https://natally.surge.sh"

# GEMINI_API_KEY: Direct Gemini access (legacy engine; also powers TTS when present).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Inference engines ────────────────────────────────────────────────────────
# INFERENCE_ENGINE selects the chat/readings engine:
#   openrouter        — OpenRouter free tier via OPENROUTER_API_KEY (auto-default
#                       when that key is present)
#   gemini            — direct GEMINI_API_KEY access
#   openai-compatible — any OpenAI-shaped endpoint via CUSTOM_LLM_* (z.ai GLM
#                       Coding Plan, Ollama, LM Studio, …)
#   venice            — direct Venice inference via VENICE_API_KEY
#   venice-admin      — reserved: admin-key provisioning of spend-limited user keys
#   openrouter-admin  — reserved: per-user provisioned keys (40% of top-up)
#   local             — reserved: atomic-chat llama.cpp / wllama3, no spend limit
# Unset = auto (openrouter if OPENROUTER_API_KEY present, else gemini).
#INFERENCE_ENGINE="openrouter"

# ── OpenRouter operator tooling / optional legacy local server ──────────────
OPENROUTER_API_KEY="sk-or-v1-"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Local server only: OPENROUTER_MODEL is an optional explicit model id. Unset = free-tier chain
# (deepseek-chat-v3-0324:free → llama-3.3-70b:free → gemma-3-27b:free) with
# automatic fallback when a free model is delisted or rate-capped.
#OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324:free"

# ── OpenRouter admin (billing provisioning service only) ──────────────────
OPENROUTER_ADMIN_KEY="sk-or-v1-"

# ── Billing policy: DOCS/BILLING-SPEC.md ────────────────────────────────────
# Apply server settings to the deployment after changing .env.
# Missing required server credentials keeps payment methods unavailable.
BILLING_POLICY_VERSION="v3"
# v3 is the initial real-payment tester policy: USD 0.99 per card product.
# v1/v2 are historical; existing receipts retain their immutable policy snapshot.
BILLING_OFFER_PRICE_USD="0.99"
# Ten completed turns. Provider allowance is a separate, finite cost ceiling.
# Hosted archive delivery remains a separate acceptance item (DOCS/BILLING-SPEC.md).
BILLING_INCLUDED_TURNS="10"
BILLING_INCLUDED_INFERENCE_USD="0.02"
BILLING_TOPUP_ALLOCATION_BPS="4000"
BILLING_ARCHIVE_ACCESS_YEARS="1"
BILLING_COST_PAYMENT_USD=""
BILLING_COST_GENERATION_USD=""
BILLING_COST_HOSTING_YEAR_USD=""
BILLING_COST_SUPPORT_USD=""
BILLING_COST_FIXED_SUBSIDY_USD=""
BILLING_COST_RESERVE_USD=""
# Required live catalog; IDs below were provisioned in this pass.
# Product IDs are RevenueCat prod... IDs, packageId is its lookup key (not pkg...).
# Prices are integer USD micros / sats / atomic crypto units. No conversion rate is inferred.
# A 1-sat or 0.01-USDC tester purchase is explicitly subsidized with a $0.02 provider allowance.
# ROCHE grants below are explicit promotional units, not a USD conversion. Do not also
# configure automatic virtual-currency grants on these products (the ledger grants once).
# The same JSON is deployed in Netlify's functions scope. Blank product IDs disable card.
BILLING_PRODUCTS_JSON='{"reading":{"title":"Natally tester reading","kind":"bundle","productId":"proda88125bed7","packageId":"natally_reading_test","usdMicros":990000,"sats":1,"x402Amount":"10000","x402Label":"0.01 USDC","roche":1,"turns":10,"inferenceMicros":20000,"entitlementId":"entlbc6dd8a62a","downloadEntitlementId":"entl2ef69e9c03","formats":["pdf","wav","markdown","png","jpg","transcript"]},"roche":{"title":"Natally tester conversation credits","kind":"topup","productId":"prod2f046e3b64","packageId":"natally_roche_test","usdMicros":990000,"sats":1,"x402Amount":"10000","x402Label":"0.01 USDC","roche":1,"turns":10,"inferenceMicros":20000,"entitlementId":"entlbc6dd8a62a","formats":[]}}'
BILLING_ENVIRONMENT="PRODUCTION"
BILLING_ALLOWED_ORIGIN="https://natally.surge.sh"
REVENUECAT_PROJECT_ID="projaba0bd94"
REVENUECAT_OFFERING_ID="ofrng352609e01b"
# Natally (Web Billing); does not change the ecosystem's default offering.
REVENUECAT_APP_ID="app941a60bf95"
REVENUECAT_PUBLIC_API_KEY="rcb_VytrEQiAklKDYKCxYRERngGnqcSo"
# Server v2 key permissions: Customers read/write; Purchases read/write.
# Put the real secret in Netlify / an ignored .env. Never paste it into chat.
REVENUECAT_SECRET_API_KEY=""
# Set this exact value as the RevenueCat webhook Authorization header.
# Webhook: https://natally-hosted-chat.netlify.app/billing/revenuecat/webhook
REVENUECAT_WEBHOOK_AUTH=""
# Capability names => RevenueCat entitlement IDs; only these are copied to claims.
REVENUECAT_CAPABILITIES_JSON='{"reading":"entlbc6dd8a62a","downloads":"entl2ef69e9c03"}'
# Currency code is deliberately fixed to ROCHE in the service, never AICREDIT.
# 32 cryptographically random bytes, base64 encoded; keep stable across deployments.
BILLING_KEY_ENCRYPTION_KEY=""
# Optional existing Postgres URL. Empty uses Netlify Database (@netlify/database).
# Apply netlify/database/migrations/202610250001_billing.sql to an external DB.
BILLING_DATABASE_URL=""
BILLING_PUBLIC_URL="https://natally-hosted-chat.netlify.app"
# Runtime Firebase Admin credentials (functions only). Use a service account scoped
# to this existing project with Firebase Authentication Admin and Datastore User.
# Supply JSON as one line in the secret manager, or use Application Default Credentials.
FIREBASE_PROJECT_ID="gen-lang-client-0714568880"
FIREBASE_DATABASE_ID="ai-studio-remixastrosphere-1ee57c33-6487-411a-a872-59fbf4cbfc63"
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Project DISPLAY NAME must be Natally; the immutable project/database IDs stay above.
# Merchant receiving wallet, NWC permissions: make_invoice, lookup_invoice, get_info.
# No pay_invoice or wallet withdrawal permission is needed.
ALBY_NWC_URL=""
# Blink production merchant API key and BTC wallet ID. Invoices are checked at Blink.
BLINK_API_KEY=""
BLINK_WALLET_ID=""
# x402 v2 exact EIP-3009 on a production EVM network. Set all of these together.
# Example price 10000 assumes 6-decimal USDC; select the correct deployed asset.
# No facilitator, asset address or merchant payee is guessed.
X402_FACILITATOR_URL=""
X402_FACILITATOR_TOKEN=""
X402_NETWORK=""
X402_ASSET=""
X402_PAY_TO=""
X402_ASSET_NAME="USD Coin"
X402_ASSET_VERSION="2"
# Set only when the verified service is deployed; base URL before /billing/*.
#VITE_BILLING_API_URL="https://natally-hosted-chat.netlify.app"

# ── Venice.ai ────────────────────────────────────────────────────────────────
VENICE_API_KEY="VENICE_INFERENCE_KEY_"
VENICE_BASE_URL="https://api.venice.ai/api/v1"
# VENICE_MODEL: optional default model slug (unset = venice-uncensored-1-2;
# catalog also carries z-ai-glm-5-3-flash, gemini-3-8-flash, …).
#VENICE_MODEL="venice-uncensored-1-2"
# Admin key (reserved: provisioning, not used yet)
VENICE_ADMIN_KEY="VENICE_ADMIN_KEY_"

# ── Generic OpenAI-compatible endpoint (z.ai / Ollama / LM Studio / …) ───────
# CUSTOM_LLM_BASE_URL: e.g. z.ai GLM Coding Plan "https://api.z.ai/api/coding/paas/v4",
# standard z.ai "https://api.z.ai/api/paas/v4", or Ollama "http://localhost:11434/v1".
#CUSTOM_LLM_BASE_URL="https://api.z.ai/api/coding/paas/v4"
#CUSTOM_LLM_API_KEY="MY_ZAI_OR_OTHER_KEY"        # optional for local Ollama
#CUSTOM_LLM_MODEL="glm-5.3-flash"                # single default model
#CUSTOM_LLM_MODELS="glm-5.3-flash,glm-5.3-air"   # optional comma-separated fallback chain
VITE_NATALLY_MASCOT_URL="/natally-mascot.webp"
VITE_NATALLY_HEADER_SIZE="72"
VITE_NATALLY_SPEAKING_SIZE="112"

# Optional authenticated commerce adapter; leave unset until real catalog/verification is deployed.
#VITE_DOWNLOAD_ACCESS_API_URL="https://natally-hosted-chat.netlify.app/billing/download-access"


# Visible output plus reasoning budget; reading length is not a word quota.
VITE_OPENROUTER_MAX_TOKENS="16384"
VITE_OPENROUTER_TEMPERATURE="0.8"
